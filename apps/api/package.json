{
  "name": "@petvetai/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pet Vet AI API — auth, pets, care scheduling, AI safety layer, appointments, messaging",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate-cli.ts",
    "seed": "tsx src/seed-cli.ts",
    "import:workbook": "tsx src/import-workbook.ts",
    "import:breedwise": "tsx scripts/import-breedwise.ts",
    "import:vaccine-schedule": "tsx src/import-vaccine-schedule.ts",
    "backfill:vaccine-rag": "tsx scripts/backfill-vaccine-rag.ts",
    "test": "tsx --test test/*.test.ts",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exa-js": "2.25.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
