# ──────────────────────────────────────────────────────────────
# Pet Vet AI — environment template
# Copy to `.env` at the repository root. Never commit real secrets.
# ──────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:4200
APP_TIMEZONE=Asia/Kolkata

# ── Database ──────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PostgreSQL engine
# (PGlite) stored in PGLITE_DIR. Set DATABASE_URL to use a real
# PostgreSQL 14+ server instead (e.g. docker compose up postgres).
# DATABASE_URL=postgresql://petvet:petvet@localhost:5432/petvet
PGLITE_DIR=.data/pg
# Neon also provides a direct (unpooled) URL. When set, migrations use it
# instead of the pooled one, which is the recommended connection type for
# schema changes. Application queries always use DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://...@ep-xxx.c-3.<region>.aws.neon.tech/neondb?sslmode=require

# TLS for DATABASE_URL connections. Defaults to on in production because
# Neon and Supabase require it. Set to false for a plain local Postgres.
# DATABASE_SSL=false

# ── Auth ──────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 48
JWT_SECRET=dev-only-change-me-please-32-bytes-minimum
JWT_EXPIRES_IN=12h

# ── Reference catalogs ───────────────────────────────────────
# Seeds species, breeds, food-safety entries, approved vaccine schedules,
# the knowledge base and nutrition guidance. It never creates accounts,
# pets or clinics: run `npm run create-admin --prefix apps/api -- \
# you@example.com "your-password"` for the first administrator.
SEED_CATALOG=true

# ── Language model (optional) ────────────────────────────────
# LLM_PROVIDER=none runs the transparent demo composer: approved
# reference snippets + safety rules, with no generative model.
# Supported: none | openai-compatible
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=20000
AI_MAX_MESSAGES_PER_DAY=80

# ── Live web search (optional, Exa) ─────────────────────────
# Server-side key for the "Live web search" panel on the Pet Vet AI
# page. Create one at https://dashboard.exa.ai/api-keys. It is never sent
# to the browser. Empty → the panel explains how to enable it, and
# everything else keeps working.
EXA_API_KEY=

# ── Uploads ──────────────────────────────────────────────────
# disk = store files under UPLOAD_DIR (local development).
# db   = store files in Postgres, for hosts without a persistent disk
#        (Render free, Cloud Run, serverless). Requires migration 005.
FILE_STORAGE=disk
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ── Email (password resets and reminder emails) ──────────────
# EMAIL_PROVIDER picks the transport:
#   brevo  → HTTPS API (port 443). Use this on hosts that block SMTP,
#            e.g. Render free web services (ports 25/465/587 blocked).
#            Free plan: 300 emails/day. Verify ONE sender address under
#            Senders & IPs → Senders; no domain needed. API key:
#            https://app.brevo.com/settings/keys/api
#   resend → HTTPS API. Without a verified domain it only delivers to the
#            address that owns the Resend account.
#   smtp   → the SMTP_* settings below (local development).
# Leave EMAIL_PROVIDER empty to fall back to SMTP when SMTP_HOST is set.
# With neither, email is off and the forgot-password screen says so.
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Must be the verified sender. "Name <address>" is accepted.
EMAIL_FROM=Pet Vet AI <no-reply@petvet.local>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Pet Vet AI <no-reply@petvet.local>

# ── Web push (optional) ──────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@petvet.local

# ── Nearby vet hospitals ─────────────────────────────────────
# Free default: OpenStreetMap. It needs no key and no billing. A city
# search is geocoded with Nominatim and hospitals come from Overpass;
# both are community-run, so keep to their usage policies (one address
# lookup per second, one app User-Agent) — the server already does.
#
# OSM asks for a descriptive User-Agent; put a contact address in it.
# OpenStreetMap requires a genuine contact address here. Addresses at
# example.com get HTTP 403 from Nominatim, which makes the hospital search fail.
NOMINATIM_USER_AGENT=PetVetAI/1.0 (replace-with-your@email.com)
# Set to false to switch nearby search off entirely (for air-gapped hosts).
OVERPASS_ENABLED=true
# Point these at a mirror or a self-hosted instance if you prefer.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_TIMEOUT_MS=15000

# ── Google Maps (optional upgrade) ───────────────────────────
# With a Google Maps key the hospital search uses Google Places instead of
# OpenStreetMap. Without one, OpenStreetMap is used and "Open in Maps"
# deep links still work. Nothing breaks.
#
# GOOGLE_MAPS_API_KEY is a SERVER key for Places API (New) text search
# and Geocoding. It is never sent to the browser. Restrict it to your
# server's IP addresses and enable only "Places API (New)" plus
# "Geocoding API" in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
# Optional browser key for Maps JavaScript API. Only safe when it is
# HTTP-referrer restricted to your own origins.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
# Set to false to disable live Places lookups even when a key is set.
GOOGLE_PLACES_API_ENABLED=true
# Per-request timeout for Google Maps calls, in milliseconds.
GOOGLE_MAPS_TIMEOUT_MS=8000

# ── Embedded database admin socket ───────────────────────────
# When DATABASE_URL is empty (PGlite), the embedded engine is exposed
# over the PostgreSQL wire protocol so pgAdmin 4, DBeaver or psql can
# connect to it. Loopback only; no password.
PGLITE_ADMIN_SOCKET_ENABLED=true
PGLITE_ADMIN_SOCKET_HOST=127.0.0.1
PGLITE_ADMIN_SOCKET_PORT=5544

# ── WebRTC ───────────────────────────────────────────────────
# STUN is public and safe. TURN credentials stay server-side and
# are only sent to authenticated consultation participants.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
